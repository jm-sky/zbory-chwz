# Example Caddyfile configuration for Zbory CHWZ
# Place this file in /etc/caddy/Caddyfile or your Caddy configuration directory
# Adjust domain names and paths according to your setup

zbory.chwz.waw.pl, adresy.chwz.waw.pl {
  # Root directory where static files are served from
  root * /var/www/zbory-chwz

  # Enable gzip compression
  encode gzip zstd

  # Static assets with long-term cache (hashed filenames)
  # Vite hashes all JS/CSS files in /assets/ directory, so they're safe to cache long-term
  # Safe to cache for 1 year because filename changes when content changes
  @hashed_assets {
      # Match all JS and CSS files in /assets/ (Vite hashes all of them)
      path /assets/*.js
      path /assets/*.css
      path /assets/*.woff2
      path /assets/*.woff
      path /assets/*.ttf
      path /assets/*.eot
      path /webfonts/*
  }

  # HTML files should not be cached (or very short cache)
  # This ensures users always get the latest index.html
  @html_files {
      path /*.html
      path /
  }

  # Other static assets (shorter cache)
  # Only matches assets that are NOT hashed (images, favicon, etc.)
  @static_assets {
      path /favicon.ico
      path /robots.txt
      path /*.png
      path /*.jpg
      path /*.jpeg
      path /*.gif
      path /*.svg
      path /*.ico
  }

  # Apply cache headers - order matters, more specific matchers first
  header @hashed_assets {
      Cache-Control "public, max-age=31536000, immutable"
  }

  header @html_files {
      Cache-Control "no-cache, no-store, must-revalidate"
      Pragma "no-cache"
      Expires "0"
  }

  header @static_assets {
      Cache-Control "public, max-age=3600"
  }

  # API routes - proxy to FastAPI backend
  handle /api/* {
      reverse_proxy localhost:8001 {
          # Optional: add headers for backend
          header_up X-Real-IP {remote_host}
          header_up X-Forwarded-For {remote_host}
          header_up X-Forwarded-Proto {scheme}
      }
  }

  # Serve static files for all other routes
  file_server

  # Fallback to index.html for SPA routing
  try_files {path} /index.html
}

